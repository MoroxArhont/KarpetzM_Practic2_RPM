<Window x:Class="KarpetzM_Practic2_RPM.Task1Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задача 1" Height="450" Width="700"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,15"
                   Text="Условие: Вывести на экран число 2n!, где n — натуральное, n ≤ 100."/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Введите n (1..100):" VerticalAlignment="Center" Width="180"/>
            <TextBox x:Name="txtInput" Width="200" Height="25"/>
        </StackPanel>

        <Button Grid.Row="2" Content="Рассчитать" Width="150" Height="35"
                HorizontalAlignment="Left" Margin="0,10,0,10" Click="btnCalculate_Click"/>

        <StackPanel Grid.Row="3">
            <TextBlock Text="Результат:" Margin="0,0,0,5"/>
            <TextBox x:Name="txtResult" Height="150" IsReadOnly="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas"/>
        </StackPanel>

        <Button Grid.Row="4" Content="Закрыть" Width="150" Height="30"
                HorizontalAlignment="Left" Margin="0,10,0,0" Click="btnClose_Click"/>
    </Grid>
</Window>