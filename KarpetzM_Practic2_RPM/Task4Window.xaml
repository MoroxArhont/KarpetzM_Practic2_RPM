<Window x:Class="KarpetzM_Practic2_RPM.Task4Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задача 4" Height="500" Width="700"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,15"
                   Text="Условие: Дан массив a[1..n] и число b. Переставить элементы так, чтобы слева от границы стояли числа ≤ b, а справа — ≥ b."/>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Введите элементы массива через пробел:" Margin="0,0,0,5"/>
            <TextBox x:Name="txtArray" Height="60" TextWrapping="Wrap"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Число b:" VerticalAlignment="Center" Width="100"/>
            <TextBox x:Name="txtB" Width="100" Height="25"/>
        </StackPanel>

        <Button Grid.Row="3" Content="Переставить" Width="150" Height="35"
                HorizontalAlignment="Left" Margin="0,10,0,10" Click="btnCalculate_Click"/>

        <StackPanel Grid.Row="5">
            <TextBlock Text="Результат:" Margin="0,0,0,5"/>
            <TextBox x:Name="txtResult" Height="100" IsReadOnly="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <Button Grid.Row="6" Content="Закрыть" Width="150" Height="30"
                HorizontalAlignment="Left" Margin="0,10,0,0" Click="btnClose_Click"/>
    </Grid>
</Window>